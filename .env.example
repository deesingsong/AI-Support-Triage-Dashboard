# Copy to .env.local and fill in (never commit .env.local)
# Server-side Neon Postgres connection (keep secret — server only, never NEXT_PUBLIC_).
DATABASE_URL=
# Optional — enables live HuggingFace AI classification.
# Without it the app uses the built-in rules engine (works offline).
HF_TOKEN=
# Optional — HuggingFace Inference endpoint override
HF_MODEL_SENTIMENT=SamLowe/roberta-base-go_emotions
HF_MODEL_ZEROSHOT=facebook/bart-large-mnli
